# .dockerignore for the commit-image build.
# Goal: bake in the FULL repo (including .git history — the grader uses it),
# dropping only local build artifacts and editor/OS cruft. Dev image, not minimal.

# ── Build outputs / local cruft ──────────────────────────────────────────────
# build.sh runs xbps' ./configure + make in-tree and produces its outputs under
# /mayhem at build time, so the context's copies of these are noise.
config.h
config.mk
include/xbps.h
mayhem-build/
mayhem-build-test/
mayhem-tests/
**/*.o
**/*.a
**/*.so
**/*.so.*
**/*.pc
**/__pycache__/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
.*.swp
*~
